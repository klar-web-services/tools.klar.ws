# tools.klar.ws: read-only front for the release bucket.
# Rendered by the nginx image's entrypoint (envsubst); only ${S3_*} and
# ${NGINX_LOCAL_RESOLVERS} are substituted (NGINX_ENVSUBST_FILTER).
#   S3_ORIGIN       bucket URL without trailing slash, virtual-host or path style:
#                   https://<bucket>.fsn1.your-objectstorage.com | http://s3:9000/<bucket>
#   S3_CACHE_VALID  how long a fetched object is reused before re-checking, e.g. 1m

# Small cache, mainly so downloads keep working through short bucket outages.
# It lives on a tmpfs (see docker-compose.yml), so a restart empties it.
proxy_cache_path /var/cache/nginx/tools levels=1:2 keys_zone=tools:10m max_size=200m
                 inactive=7d use_temp_path=off;

server {
    listen 80;
    server_name _;
    server_tokens off;
    absolute_redirect off;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=60s ipv6=off;
    resolver_timeout 5s;
    set $s3_origin "${S3_ORIGIN}";

    default_type "text/plain; charset=utf-8";

    # Downloads only; never forward S3 API operations.
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }

    # Upstream (bucket) settings, inherited by the proxy locations below.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    proxy_hide_header Cache-Control;
    proxy_hide_header Set-Cookie;
    proxy_hide_header x-amz-id-2;
    proxy_hide_header x-amz-request-id;
    proxy_hide_header x-amz-storage-class;
    proxy_hide_header x-amz-version-id;
    proxy_hide_header x-amz-server-side-encryption;
    proxy_hide_header x-rgw-object-type;
    proxy_hide_header x-amz-bucket-region;

    proxy_cache tools;
    proxy_cache_key $uri;
    proxy_cache_valid 200 ${S3_CACHE_VALID};
    proxy_ignore_headers Cache-Control Expires Set-Cookie X-Accel-Expires;
    proxy_cache_revalidate on;
    proxy_cache_lock on;
    proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;

    # Never pass the bucket's own error bodies through: S3 error XML names the
    # bucket. Without list permission the bucket answers 403 for missing keys.
    proxy_intercept_errors on;
    error_page 400 401 403 404 = @missing;
    error_page 500 502 503 504 = @unavailable;

    location = /healthz { access_log off; return 200 "ok\n"; }

    location = / { rewrite ^ /index.html last; }
    location ~ ^/[a-z0-9][a-z0-9-]*$ { return 301 $uri/; }
    location ~ ^/[a-z0-9][a-z0-9-]*/$ { rewrite ^(.*)/$ $1/index.html last; }

    # Released files never change.
    location ~ ^/[a-z0-9][a-z0-9-]*/v[^/]+/[^/]+$ {
        proxy_pass $s3_origin$uri;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Cache $upstream_cache_status;
    }

    # Install scripts, landing pages, latest: may change with every release.
    location / {
        proxy_pass $s3_origin$uri;
        add_header Cache-Control "public, max-age=300";
        add_header X-Cache $upstream_cache_status;
    }

    location @missing { return 404 "not found\n"; }
    location @unavailable { return 503 "temporarily unavailable, please retry\n"; }
}
